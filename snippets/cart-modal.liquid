{%- comment -%}
  Cart Success Modal
  Displays when an item is added to cart
{%- endcomment -%}

<div id="cart-modal" class="cart-modal" style="display: none;">
  <div class="cart-modal-overlay"></div>
  <div class="cart-modal-content">
    <div class="cart-modal-header">
      <h2 class="neon-text-gold text-2xl sm:text-3xl font-heading mb-4">Item Added to Cart</h2>
    </div>
    <div class="cart-modal-body">
      <p class="text-bekky-gray-light mb-6 text-lg">Your item has been successfully added to your cart!</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button id="cart-modal-continue" class="neon-button neon-button-lg flex-1 sm:flex-none">
          Continue Shopping
        </button>
        <a href="{{ routes.cart_url }}" class="neon-button-gold neon-button-lg flex-1 sm:flex-none text-center">
          View Cart
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .cart-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .cart-modal-content {
    position: relative;
    background: var(--bekky-gray-dark);
    border: 2px solid var(--bekky-purple-neon);
    border-radius: 1rem;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
    box-shadow: 0 0 20px rgba(155, 127, 255, 0.5), 0 0 40px rgba(155, 127, 255, 0.3);
    text-align: center;
    z-index: 10000;
  }

  .cart-modal-header {
    margin-bottom: 1rem;
  }

  .cart-modal-body {
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .cart-modal-content {
      padding: 1.5rem;
    }
  }
</style>

