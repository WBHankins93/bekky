{%- comment -%}
  Customer Registration/Signup Page
  Converted from app/members/page.tsx signup form
  This is the registration page for new customers
{%- endcomment -%}

<div class="min-h-screen bg-black py-12 sm:py-16 md:py-24">
  <div class="container">
    <div class="text-center mb-12 sm:mb-16 px-4">
      <h1 class="display-heading mb-4 sm:mb-6 text-3xl sm:text-4xl md:text-6xl">Join BBA Members 👑</h1>
      <p class="section-subtitle text-sm sm:text-base md:text-lg">
        Unlock exclusive rewards, earn BekkyBucks, and join Bekky's inner circle!
      </p>
    </div>

    {%- comment -%} Member Benefits Grid {%- endcomment -%}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 md:gap-8 mb-12 sm:mb-16 items-stretch px-4">
      <div class="neon-card scan-line text-center flex flex-col">
        <div class="mb-6 h-20 flex items-center justify-center">
          <span class="text-6xl animate-float leading-none">💰</span>
        </div>
        <h3 class="text-xl text-bekky-purple-neon mb-4 font-heading h-14 flex items-center justify-center leading-tight">Earn BekkyBucks</h3>
        <p class="text-bekky-gray-light flex-grow flex items-start justify-center pt-2">
          Get 1 BekkyBuck for every $10 spent. Stack 'em up, cash 'em in!
        </p>
      </div>
      
      <div class="neon-card-gold scan-line text-center flex flex-col">
        <div class="mb-6 h-20 flex items-center justify-center">
          <span class="text-6xl animate-float leading-none">🎁</span>
        </div>
        <h3 class="text-xl text-bekky-gold-neon mb-4 font-heading h-14 flex items-center justify-center leading-tight">Exclusive Discounts</h3>
        <p class="text-bekky-gray-light flex-grow flex items-start justify-center pt-2">
          Member-only sales, early access to drops, and special promo codes.
        </p>
      </div>
      
      <div class="neon-card scan-line text-center flex flex-col">
        <div class="mb-6 h-20 flex items-center justify-center">
          <span class="text-6xl animate-float leading-none">🦙</span>
        </div>
        <h3 class="text-xl text-bekky-purple-neon mb-4 font-heading h-14 flex items-center justify-center leading-tight">Bekky's Inner Circle</h3>
        <p class="text-bekky-gray-light flex-grow flex items-start justify-center pt-2">
          Join the llama queen's exclusive crew. Festival fam perks and more!
        </p>
      </div>
    </div>

    {%- comment -%} Sign Up Section {%- endcomment -%}
    <div class="max-w-2xl mx-auto px-4">
      <div class="neon-card text-center">
        <div class="mb-8">
          <img
            src="{{ 'bekky-no-background.png' | asset_url }}"
            alt="Bekky the Purple Llama - Big Butt Association Mascot"
            width="150"
            height="150"
            class="mx-auto mb-6 rounded-full"
            loading="lazy"
          />
        </div>
        
        <div class="bg-bekky-purple-neon/10 border-l-4 border-bekky-gold-neon p-6 rounded-lg mb-8 text-left">
          <p class="font-bold text-bekky-gold-neon mb-2">🎉 Special Launch Offer!</p>
          <p class="text-white">Sign up now and get 10 FREE BekkyBucks to start!</p>
        </div>
        
        <h3 class="neon-text-gold text-2xl mb-6 font-heading">Member Benefits:</h3>
        <ul class="space-y-3 mb-8 text-left max-w-md mx-auto">
          <li class="text-bekky-gray-light">✅ Earn 1 BekkyBuck per $10 spent</li>
          <li class="text-bekky-gray-light">✅ Redeem BekkyBucks for discounts</li>
          <li class="text-bekky-gray-light">✅ Exclusive member-only sales</li>
          <li class="text-bekky-gray-light">✅ Early access to new drops</li>
          <li class="text-bekky-gray-light">✅ Birthday rewards & surprises</li>
        </ul>
        
        {%- form 'create_customer', class: 'space-y-6' -%}
          {%- if form.errors -%}
            <div class="bg-red-500/10 border-2 border-red-500 rounded-lg p-4 mb-6">
              <p class="text-red-400 text-sm">{{ form.errors | default_errors }}</p>
            </div>
          {%- endif -%}

          <div>
            <label for="signupEmail" class="form-label block mb-2">
              Email
            </label>
            <input
              type="email"
              id="signupEmail"
              name="customer[email]"
              class="form-input"
              placeholder="your@email.com"
              required
              autocomplete="email"
            />
          </div>
          
          <div>
            <label for="signupPassword" class="form-label block mb-2">
              Password
            </label>
            <input
              type="password"
              id="signupPassword"
              name="customer[password]"
              class="form-input"
              placeholder="Create a password"
              required
              autocomplete="new-password"
            />
          </div>
          
          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="agreeTerms"
              name="customer[accepts_marketing]"
              class="w-5 h-5 accent-bekky-purple"
            />
            <label for="agreeTerms" class="text-sm text-bekky-gray-light">
              I agree to receive emails about exclusive offers and BekkyBucks updates
            </label>
          </div>
          
          <button type="submit" class="neon-button-gold neon-button-lg w-full">
            Sign Up Free →
          </button>
        {%- endform -%}
        
        <p class="text-sm text-bekky-gray-light mt-6">
          Already a member? 
          <a href="{{ routes.account_login_url }}" class="neon-text-purple hover:text-bekky-gold-neon transition-colors">
            Login here
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

