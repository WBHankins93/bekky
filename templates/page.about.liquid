{%- comment -%}
  About Page Template
  Converted from app/about/page.tsx
{%- endcomment -%}

<div class="min-h-screen bg-black py-12 sm:py-16 md:py-24">
  <div class="container">
    {%- comment -%} Page Header {%- endcomment -%}
    <div class="section-header mb-12 sm:mb-16 md:mb-20">
      <h1 class="display-heading mb-4 text-3xl sm:text-4xl md:text-6xl">About Big Butt Association</h1>
      <p class="section-subtitle text-sm sm:text-base md:text-lg px-4">
        Meet the crew behind the bootylicious brand and discover our festival-fueled story.
      </p>
    </div>

    {%- comment -%} BekkyWithABigButt Section - 2 Column Layout {%- endcomment -%}
    <section class="mb-16 sm:mb-24 md:mb-32">
      <div class="container px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 items-center">
        {%- comment -%} Text Content - Left Column {%- endcomment -%}
        <div class="space-y-6">
          <h2 class="neon-text-purple text-4xl mb-6 font-heading">Meet BekkyWithABigButt</h2>
          <h3 class="neon-text-gold text-2xl mb-6 font-heading">Our Fearless Leader</h3>
          <p class="text-bekky-gray-light leading-relaxed text-lg">
            None other than BekkyWithABigButt, a multidimensional purple alpaca 
            with curves for days and an attitude to match. She's our spirit animal—wild, free, and 
            unapologetically herself.
          </p>
          <p class="text-bekky-gray-light leading-relaxed text-lg">
            If it's Bekky Approved, you know it's fire.
          </p>
        </div>
        {%- comment -%} Bekky Image - Right Column {%- endcomment -%}
        <div class="flex justify-center">
          <img
            src="{{ 'bekky-no-background.png' | asset_url }}"
            alt="Bekky the Purple Alpaca Queen - Big Butt Association Mascot Character"
            width="400"
            height="400"
            class="w-full max-w-[400px] h-auto rounded-2xl border-2 border-bekky-purple-neon shadow-neon-purple-md glow-on-hover"
            loading="lazy"
          />
        </div>
        </div>
      </div>
    </section>

    {%- comment -%} Jared Section - 2 Column Layout {%- endcomment -%}
    <section class="mb-16 sm:mb-24 md:mb-32">
      <div class="container px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 items-center">
        {%- comment -%} Jared Image - Left Column {%- endcomment -%}
        <div class="flex justify-center order-2 md:order-1">
          <img
            src="{{ 'jared-main.png' | asset_url }}"
            alt="Jared - The Most Valuable Wook - Big Butt Association Co-Founder"
            width="400"
            height="400"
            class="w-full max-w-[400px] h-auto rounded-2xl border-2 border-bekky-gold-neon shadow-neon-gold-md object-cover"
            loading="lazy"
          />
        </div>
        {%- comment -%} Jared Text - Right Column {%- endcomment -%}
        <div class="space-y-6 order-1 md:order-2">
          <h2 class="neon-text-gold text-4xl mb-6 font-heading">Jared</h2>
          <h3 class="neon-text-purple text-2xl mb-6 font-heading">The Most Valuable Wook</h3>
          <p class="text-bekky-gray-light leading-relaxed text-lg">
            Jared aka Dr.KushKing & BekkyWithABigButt is the mastermind behind the Big Butt Association, bringing the energy, the vision, 
            and the absolute best vibes to every event. Known as "The most valuable Wook" 
            Jared knows how to throw a party and create unforgettable festival vibes & connections.
          </p>
        </div>
        </div>
      </div>
    </section>

    {%- comment -%} Big Butt Association Brand Section {%- endcomment -%}
    <section class="mb-16 sm:mb-24 md:mb-32 px-4">
      <div class="neon-card max-w-4xl mx-auto">
        <h2 class="neon-text-gold text-2xl sm:text-3xl md:text-4xl mb-6 sm:mb-8 font-heading text-center">The Big Butt Association</h2>
        <div class="space-y-6">
          <p class="text-bekky-gray-light leading-relaxed text-lg">
            Hey, festival fam! We're Big Butt Association (BBA)—where bass meets booty and style meets statement. 
            We're not just a brand; we're a movement, a vibe, and a celebration of every body that knows 
            how to move to the music. Whether you're headbanging at the rail, shuffling under neon lights, 
            or sauced on a side quest, BBA is here to make sure you look as bold as you feel.
          </p>
          <p class="text-bekky-gray-light leading-relaxed text-lg">
            Join the Big Butt Association and let's make the festival world a little wilder, a little brighter, 
            and a whole lot thicker.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
            <div class="text-center">
              <div class="text-4xl mb-4">🎵</div>
              <h3 class="neon-text-purple text-xl mb-2 font-heading">Festival Culture</h3>
              <p class="text-bekky-gray-light text-sm">
                Rooted in EDM and rave culture, celebrating the music and community
              </p>
            </div>
            <div class="text-center">
              <div class="text-4xl mb-4">👑</div>
              <h3 class="neon-text-gold text-xl mb-2 font-heading">Exclusivity</h3>
              <p class="text-bekky-gray-light text-sm">
                Member-only perks, early access, and exclusive drops for the BBA family
              </p>
            </div>
            <div class="text-center">
              <div class="text-4xl mb-4">🦙</div>
              <h3 class="neon-text-purple text-xl mb-2 font-heading">Community</h3>
              <p class="text-bekky-gray-light text-sm">
                Building connections and celebrating together at festivals and events
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} CTA Section {%- endcomment -%}
    <section class="mt-16 sm:mt-24 px-4">
      <div class="flex justify-center">
        <div class="neon-card-gold max-w-2xl mx-auto text-center">
        <h2 class="neon-text-gold text-3xl mb-4 font-heading">Join the Movement</h2>
        <p class="text-bekky-gray-light mb-6 text-lg">
          Ready to become part of the Big Butt Association? Join BBA Fam and unlock exclusive 
          rewards, early access to drops, and connect with the BBA community!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/pages/members" class="neon-button-gold neon-button-lg w-full sm:w-auto text-center">
            Join BBA Fam
          </a>
          <a href="{{ routes.collections_url }}" class="neon-button neon-button-lg w-full sm:w-auto text-center">
            Shop the Collection
          </a>
        </div>
        </div>
      </div>
    </section>
  </div>
</div>

