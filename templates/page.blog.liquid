{%- comment -%}
  Blog Page Template
  Converted from app/blog/page.tsx
{%- endcomment -%}

<div class="min-h-screen bg-black py-12 sm:py-16 md:py-24">
  <div class="container">
    <div class="text-center px-4 mb-12 sm:mb-16">
      <h1 class="display-heading mb-4 sm:mb-6 text-3xl sm:text-4xl md:text-6xl">
        Bekky's Adventures
      </h1>
      <p class="text-bekky-gray-light text-lg sm:text-xl max-w-2xl mx-auto">
        Coming soon: Festival recaps, interviews, and behind-the-scenes content!
      </p>
    </div>
    
    {%- comment -%} Blog Post Placeholders {%- endcomment -%}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 px-4">
      {%- for i in (1..3) -%}
        <div class="neon-card">
          <div class="w-full h-48 bg-bekky-gray-dark rounded-lg mb-4 flex items-center justify-center">
            <span class="text-6xl">📝</span>
          </div>
          <h3 class="neon-text-purple text-xl mb-3 font-heading">Blog Post {{ i }}</h3>
          <p class="text-bekky-gray-light mb-4">
            This is a placeholder for future blog content. Check back soon for festival recaps, interviews, and behind-the-scenes stories!
          </p>
          <a href="#" class="neon-button neon-button-sm inline-block">
            Read More
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

