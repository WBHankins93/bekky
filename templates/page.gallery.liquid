          class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
          loading="lazy"
        />
      </div>

      {%- comment -%} Image 3: jared-edsea.PNG {%- endcomment -%}
      <div class="gallery-item overflow-hidden rounded-2xl border-2 border-bekky-gold-neon shadow-neon-gold-md hover:shadow-neon-gold-lg transition-all">
