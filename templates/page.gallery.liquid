{%- comment -%}
  Gallery Page Template
  Converted from app/gallery/page.tsx
{%- endcomment -%}

<div class="min-h-screen bg-black py-12 sm:py-16 md:py-24">
  <div class="container">
    <div class="text-center px-4 mb-12 sm:mb-16">
      <h1 class="display-heading mb-4 sm:mb-6 text-3xl sm:text-4xl md:text-6xl">
        BekkyWithABigButt in the Wild
      </h1>
      <p class="text-bekky-gray-light text-lg sm:text-xl max-w-2xl mx-auto">
        Photos from festivals, events, and adventures!
      </p>
    </div>

    {%- comment -%} Gallery Grid {%- endcomment -%}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 px-4">
      {%- comment -%} Image 1: bong-bekky.JPG {%- endcomment -%}
      <div class="gallery-item overflow-hidden rounded-2xl border-2 border-bekky-purple-neon shadow-neon-purple-md hover:shadow-neon-purple-lg transition-all">
        <img
          src="{{ 'bong-bekky.JPG' | asset_url }}"
          alt="Bekky at festival event"
          class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
          loading="lazy"
        />
      </div>

      {%- comment -%} Image 2: edsea-bekky.JPEG {%- endcomment -%}
