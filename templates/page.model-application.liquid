                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="contact[substances][]" value="None" class="w-5 h-5 accent-bekky-purple">
                  <span class="text-bekky-gray-light">None</span>
                </label>
              </div>
              
              <div class="mt-4">
                <label for="substances_other" class="form-label block mb-2">If 'Other', specify:</label>
