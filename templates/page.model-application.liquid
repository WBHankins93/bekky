                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="Marijuana" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">Marijuana</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="Cocaine" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">Cocaine</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="MDMA" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">MDMA</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="Ketamine" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">Ketamine</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="LSD / Acid" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">LSD / Acid</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="Prescription (non-prescribed use)" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">Prescription (non-prescribed use)</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="Other" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">Other</span>
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="contact[substances][]" value="None" class="w-5 h-5 accent-bekky-purple">
                        <span class="text-bekky-gray-light">None</span>
                      </label>
                    </div>
                    
                    <div class="mt-4">
                      <label for="substances_other" class="form-label block mb-2">If 'Other', specify:</label>
                      <input 
                        type="text" 
                        id="substances_other" 
                        name="contact[substances_other]" 
                        class="form-input"
                        value="{{ form.substances_other }}"
                      >
                    </div>
                  </div>

                  {%- comment -%} Agreements {%- endcomment -%}
                  <div class="space-y-6">
                    <div class="bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-lg p-6">
                      <h3 class="text-bekky-gold-neon text-lg mb-3 font-heading">Merch & Contract Agreement</h3>
                      <ul class="text-bekky-gray-light text-sm space-y-2 mb-4">
                        <li>• All merch provided remains BBA property unless earned or gifted.</li>
                        <li>• If contractual standards are not upheld, merch must be returned or purchased.</li>
                        <li>• No resale of BBA merch without written permission.</li>
                      </ul>
                      <label class="flex items-center gap-3 cursor-pointer">
                        <input 
                          type="checkbox" 
                          name="contact[merch_agreement]" 
                          value="agreed" 
                          class="w-5 h-5 accent-bekky-gold" 
                          required
                        >
                        <span class="text-white font-bold">I understand and agree. *</span>
                      </label>
                    </div>

                    <div class="bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-lg p-6">
                      <h3 class="text-bekky-gold-neon text-lg mb-3 font-heading">Code of Conduct</h3>
                      <ul class="text-bekky-gray-light text-sm space-y-2 mb-4">
                        <li>• Represent the brand with confidence & respect.</li>
                        <li>• Maintain professionalism online & in person.</li>
                        <li>• Avoid actions that harm the BBA image.</li>
                        <li>• Respect fellow models, staff & community members.</li>
                      </ul>
                      <label class="flex items-center gap-3 cursor-pointer">
                        <input 
                          type="checkbox" 
                          name="contact[code_conduct]" 
                          value="agreed" 
                          class="w-5 h-5 accent-bekky-gold" 
                          required
                        >
                        <span class="text-white font-bold">I agree to follow the BBA Code of Conduct. *</span>
                      </label>
                    </div>

                    <div class="bg-bekky-gold-neon/10 border-2 border-bekky-gold-neon rounded-lg p-6">
                      <h3 class="text-bekky-gold-neon text-lg mb-3 font-heading">BBA Model Statement</h3>
                      <p class="text-bekky-gray-light text-sm mb-4">
                        I understand that representing BBA means more than posting photos.<br>
                        I represent confidence, respect, and the culture we are building together.<br>
                        I choose to show up with integrity, energy, and intention.
                      </p>
                      <label class="flex items-center gap-3 cursor-pointer">
                        <input 
                          type="checkbox" 
                          name="contact[model_statement]" 
                          value="agreed" 
                          class="w-5 h-5 accent-bekky-gold" 
                          required
                        >
                        <span class="text-white font-bold">I agree. *</span>
                      </label>
                    </div>
                  </div>

                  {%- comment -%} Signature {%- endcomment -%}
                  <div>
                    <h3 class="text-bekky-purple-neon text-xl mb-4 font-heading">Signature</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <div>
                        <label for="signature_name" class="form-label block mb-2">Printed Name *</label>
                        <input 
                          type="text" 
                          id="signature_name" 
                          name="contact[signature_name]" 
                          class="form-input" 
                          required
                          value="{{ form.signature_name }}"
                        >
                      </div>
                      <div>
                        <label for="signature_date" class="form-label block mb-2">Date *</label>
                        <input 
                          type="date" 
                          id="signature_date" 
                          name="contact[signature_date]" 
                          class="form-input" 
                          required
                          value="{{ form.signature_date }}"
                        >
                      </div>
                    </div>
                    <div class="mt-4">
                      <label for="signature" class="form-label block mb-2">Signature (type your full name) *</label>
                      <input 
                        type="text" 
                        id="signature" 
                        name="contact[signature]" 
                        class="form-input font-signature text-2xl" 
                        placeholder="Type your full name"
                        required
                        value="{{ form.signature }}"
                      >
                      <p class="text-bekky-gray-light text-xs mt-2">By typing your name, you are providing a legal signature.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

        {%- comment -%} Submit Button {%- endcomment -%}
        <div class="text-center mt-8">
          <button type="submit" class="neon-button-gold neon-button-lg px-12">
            Submit Application
          </button>
          <p class="text-bekky-gray-light text-sm mt-4">* Required fields</p>
        </div>

      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .font-signature {
    font-family: 'Brush Script MT', cursive;
  }

  /* Accordion Styles */
  .accordion-container {
    max-width: 100%;
  }

  .accordion-item {
    margin-bottom: 1rem;
  }

  .accordion-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: rgba(0, 0, 0, 0.7);
    border: 2px solid var(--bekky-purple-neon);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
  }

  .accordion-header:hover {
    background: rgba(155, 127, 255, 0.1);
    border-color: var(--bekky-gold-neon);
    box-shadow: 0 0 15px rgba(155, 127, 255, 0.3);
  }

  .accordion-header[aria-expanded="true"] {
    border-color: var(--bekky-gold-neon);
    box-shadow: 0 0 20px rgba(255, 246, 126, 0.4);
  }

  .accordion-icon {
    color: var(--bekky-purple-neon);
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .accordion-header[aria-expanded="true"] .accordion-icon {
    transform: rotate(180deg);
    color: var(--bekky-gold-neon);
  }

  .accordion-content {
    margin-top: 0.5rem;
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section-complete-icon {
    transition: all 0.3s ease;
    filter: drop-shadow(0 0 8px rgba(57, 255, 20, 0.8));
  }

  .section-complete-icon.hidden {
    display: none;
  }

  /* Force center subtitle - override any conflicting styles */
  .container .text-center p {
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
    display: block !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const accordionHeaders = document.querySelectorAll('.accordion-header');
    
    // Section field mappings - required fields for each section
    const sectionFields = {
      'section-1': [
        '#legal_name',
        '#date_of_birth',
        '#location',
        '#phone',
        '#email'
      ],
      'section-2': [
        '#why_represent_bekky',
        '#what_bba_represents',
        '#self_expression',
        '#bba_definition',
        '#contribution',
        '#scenario_response'
      ],
      'section-3': [
        // Section 3 has no required fields, so we'll check if at least some fields are filled
        '#favorite_genre',
        '#favorite_djs',
        '#clothing_requests'
      ],
      'section-4': [
        'input[name="contact[merch_agreement]"]',
        'input[name="contact[code_conduct]"]',
        'input[name="contact[model_statement]"]',
        '#signature_name',
        '#signature_date',
        '#signature'
      ]
    };

    // Function to check if a section is complete
    function checkSectionComplete(sectionId) {
      const fields = sectionFields[sectionId];
      if (!fields) return false;

      // For section 3, we'll consider it complete if at least one field has content
      if (sectionId === 'section-3') {
        return fields.some(selector => {
          const field = document.querySelector(selector);
          if (!field) return false;
          if (field.type === 'checkbox' || field.type === 'radio') {
            return field.checked;
          }
          return field.value && field.value.trim() !== '';
        });
      }

      // For other sections, check all required fields
      return fields.every(selector => {
        const field = document.querySelector(selector);
        if (!field) return false;
        
        if (field.type === 'checkbox' || field.type === 'radio') {
          return field.checked;
        }
        
        if (field.type === 'textarea') {
          return field.value && field.value.trim() !== '';
        }
        
        return field.value && field.value.trim() !== '';
      });
    }

    // Function to update section completion icon
    function updateSectionIcon(sectionId) {
      const header = document.querySelector(`[data-accordion-target="${sectionId}"]`);
      if (!header) return;
      
      const icon = header.querySelector('.section-complete-icon');
      if (!icon) return;
      
      const isComplete = checkSectionComplete(sectionId);
      
      if (isComplete) {
        icon.classList.remove('hidden');
      } else {
        icon.classList.add('hidden');
      }
    }

    // Function to check all sections
    function checkAllSections() {
      Object.keys(sectionFields).forEach(sectionId => {
        updateSectionIcon(sectionId);
      });
    }

    // Add event listeners to all form fields
    function setupFieldListeners() {
      const form = document.getElementById('model-application-form');
      if (!form) return;

      // Listen for input, change, and blur events on all form fields
      form.addEventListener('input', function(e) {
        // Find which section this field belongs to
        const field = e.target;
        const fieldId = field.id;
        const fieldName = field.name;
        
        // Determine section based on field
        let sectionId = null;
        if (fieldId && fieldId.includes('legal_name') || fieldId.includes('date_of_birth') || 
            fieldId.includes('location') || fieldId.includes('phone') || fieldId.includes('email')) {
          sectionId = 'section-1';
        } else if (fieldId && (fieldId.includes('why_represent') || fieldId.includes('what_bba') || 
                   fieldId.includes('self_expression') || fieldId.includes('bba_definition') || 
                   fieldId.includes('contribution') || fieldId.includes('scenario'))) {
          sectionId = 'section-2';
        } else if (fieldId && (fieldId.includes('favorite_genre') || fieldId.includes('favorite_djs') || 
                   fieldId.includes('clothing_requests'))) {
          sectionId = 'section-3';
        } else if (fieldName && (fieldName.includes('merch_agreement') || fieldName.includes('code_conduct') || 
                   fieldName.includes('model_statement') || fieldId.includes('signature'))) {
          sectionId = 'section-4';
        } else if (field.closest('#section-1')) {
          sectionId = 'section-1';
        } else if (field.closest('#section-2')) {
          sectionId = 'section-2';
        } else if (field.closest('#section-3')) {
          sectionId = 'section-3';
        } else if (field.closest('#section-4')) {
          sectionId = 'section-4';
        }

        if (sectionId) {
          // Use setTimeout to ensure the value is updated
          setTimeout(() => updateSectionIcon(sectionId), 10);
        }
      });

      form.addEventListener('change', function(e) {
        const field = e.target;
        let sectionId = null;
        
        if (field.closest('#section-1')) {
          sectionId = 'section-1';
        } else if (field.closest('#section-2')) {
          sectionId = 'section-2';
        } else if (field.closest('#section-3')) {
          sectionId = 'section-3';
        } else if (field.closest('#section-4')) {
          sectionId = 'section-4';
        }

        if (sectionId) {
          setTimeout(() => updateSectionIcon(sectionId), 10);
        }
      });
    }

    // Accordion functionality
    accordionHeaders.forEach(header => {
      header.addEventListener('click', function() {
        const targetId = this.getAttribute('data-accordion-target');
        const targetContent = document.getElementById(targetId);
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        
        // Close all other accordions
        accordionHeaders.forEach(otherHeader => {
          if (otherHeader !== this) {
            const otherTargetId = otherHeader.getAttribute('data-accordion-target');
            const otherTargetContent = document.getElementById(otherTargetId);
            otherHeader.setAttribute('aria-expanded', 'false');
            if (otherTargetContent) {
              otherTargetContent.style.display = 'none';
            }
          }
        });
        
        // Toggle current accordion
        if (isExpanded) {
          this.setAttribute('aria-expanded', 'false');
          targetContent.style.display = 'none';
        } else {
          this.setAttribute('aria-expanded', 'true');
          targetContent.style.display = 'block';
        }
      });
    });

    // Initialize
    setupFieldListeners();
    checkAllSections();

    // Google Forms Integration
    var form = document.getElementById('model-application-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault(); // Stop default Shopify submission
        
        var formData = new FormData(form);
        
        // Google Forms action URL
        var googleFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdRxXg4w8HnBlzN-qXPAzi9xcsSNLcMWyAQ9LFEfWns841ecA/formResponse';
        
        // Build Google Forms data
        var googleFormData = new URLSearchParams();
        
        // Simple text fields
        var simpleFields = {
          'contact[legal_name]': '2056245631',
          'contact[preferred_name]': '1363513700',
          'contact[pronouns]': '993866760',
          'contact[date_of_birth]': '472789353',
          'contact[location]': '1299264667',
          'contact[phone]': '870948744',
          'contact[email]': '1376238800',
          'contact[instagram]': '361854997',
          'contact[tiktok]': '2014271659',
          'contact[twitter]': '82215949',
          'contact[other_platforms]': '1087736889',
          'contact[follower_count]': '450271462',
          'contact[why_represent_bekky]': '1566124579',
          'contact[what_bba_represents]': '430550869',
          'contact[self_expression]': '689652548',
          'contact[bba_definition]': '1405583744',
          'contact[contribution]': '146543066',
          'contact[scenario_response]': '205038714',
          'contact[favorite_genre]': '1981060043',
          'contact[favorite_djs]': '622949923',
          'contact[clothing_requests]': '1597003385',
          'contact[relationship_status]': '226297739',
          'contact[travel_comfortable]': '1281173279',
          'contact[festival_comfortable]': '1786034361',
          'contact[substances_other]': '1020482954',
          'contact[signature_name]': '1776958538',
          'contact[signature_date]': '1283928147',
          'contact[signature]': '1898170153'
        };
        
        // Add simple fields
        for (var key in simpleFields) {
          var value = formData.get(key);
          if (value) {
            googleFormData.append('entry.' + simpleFields[key], value);
          }
        }
        
        // Checkbox arrays
        var checkboxFields = {
          'contact[energy_types][]': '118028275',
          'contact[edm_genres][]': '493062940',
          'contact[clothing_prefs][]': '596739250',
          'contact[fabric_prefs][]': '2071065872',
          'contact[substances][]': '673783121'
        };
        
        // Add checkbox fields
        for (var key in checkboxFields) {
          var values = formData.getAll(key);
          if (values && values.length > 0) {
            values.forEach(function(value) {
              googleFormData.append('entry.' + checkboxFields[key], value);
            });
          }
        }
        
        // Add agreement checkboxes with specific values
        if (formData.get('contact[merch_agreement]')) {
          googleFormData.append('entry.1339082856', 'I understand and agree');
        }
        
        if (formData.get('contact[code_conduct]')) {
          googleFormData.append('entry.1597031769', 'I agree to follow the BBA Code of Conduct');
        }
        
        if (formData.get('contact[model_statement]')) {
          googleFormData.append('entry.2066399614', 'I agree');
        }
        
        // Submit to Google Forms
        fetch(googleFormUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
          },
          body: googleFormData.toString()
        })
        .then(function() {
          // Show success message
          window.scrollTo(0, 0);
          
          // Create success message
          var successMsg = document.createElement('div');
          successMsg.className = 'neon-card bg-bekky-green/10 border-2 border-bekky-green mb-8';
          successMsg.innerHTML = '<p class="text-bekky-green text-lg text-center">✅ Application submitted successfully! We\'ll be in touch soon.</p>';
          
          // Insert at top
          var container = document.querySelector('.max-w-4xl');
          container.insertBefore(successMsg, container.firstChild);
          
          // Hide form
          form.style.display = 'none';
        })
        .catch(function(error) {
          console.error('Error:', error);
          alert('There was an error submitting your application. Please try again.');
        });
      });
    }
  });
</script>
