{%- comment -%}
  Bunk Police Safety Partner Section
  Standalone section for homepage placement
{%- endcomment -%}

<section class="py-16 sm:py-20 md:py-24 bg-gradient-to-br from-bekky-purple to-bekky-purple-dark">
  <div class="container px-4">
    <div class="max-w-4xl mx-auto">
      <div class="neon-card-green p-6 sm:p-8 md:p-10 text-center">
        {%- comment -%} Logo {%- endcomment -%}
        <div class="mb-6 flex justify-center">
          {%- assign bunk_logo = 'bunk-logo.png' -%}
          <img
            src="{{ bunk_logo | asset_url }}"
            alt="Bunk Police Logo"
            width="300"
            height="150"
            class="max-w-[200px] sm:max-w-[250px] md:max-w-[300px] h-auto bunk-police-logo"
            loading="lazy"
          />
        </div>

        {%- comment -%} Heading {%- endcomment -%}
        <h2 class="neon-text-green text-2xl sm:text-3xl md:text-4xl mb-4 font-heading bunk-police-heading">
          Festival Safety Partner
        </h2>

        {%- comment -%} Description {%- endcomment -%}
        <div class="mb-6 sm:mb-8 bunk-police-description" style="max-width: 42rem; margin-left: auto; margin-right: auto; display: flex; justify-content: center; align-items: center;">
          <p class="text-bekky-gray-light text-base sm:text-lg leading-relaxed" style="text-align: center !important; text-align-last: center !important; display: block !important; width: 100% !important; margin: 0 !important;">
            We've partnered with Bunk Police to bring you reliable testing kits for festival safety. Stay safe, test your stuff, and rave responsibly.
          </p>
        </div>

        {%- comment -%} CTA Button {%- endcomment -%}
        <div class="flex justify-center">
          <a 
            href="https://www.bunkpolice.com/?ref=mjgxodq" 
            target="_blank" 
            rel="noopener noreferrer"
            class="neon-button-green neon-button-lg"
          >
            Shop Testing Kits →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-gradient-to-br {
    background: linear-gradient(to bottom right, var(--bekky-purple), var(--bekky-purple-dark));
  }
  
  /* Bunk Police section specific styles - FORCE CENTER */
  .neon-card-green {
    text-align: center !important;
  }
  
  .neon-card-green * {
    text-align: center !important;
  }
  
  .bunk-police-description {
    text-align: center !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
  }
  
  .bunk-police-description p {
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
    display: block !important;
    width: 100% !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  
  /* Nuclear option - target by section */
  section .neon-card-green p {
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
  
  /* Target the specific paragraph in Bunk Police section */
  section.bg-gradient-to-br .neon-card-green .bunk-police-description p,
  .bunk-police-description > p {
    text-align: center !important;
    text-align-last: center !important;
    display: block !important;
    width: 100% !important;
    margin: 0 auto !important;
  }
  
  /* Subtle white glow behind Bunk Police logo */
  .bunk-police-logo {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.4)) 
            drop-shadow(0 0 20px rgba(255, 255, 255, 0.3)) 
            drop-shadow(0 0 30px rgba(255, 255, 255, 0.2));
  }
</style>

{% schema %}
{
  "name": "Bunk Police",
  "settings": [],
  "presets": [
    {
      "name": "Bunk Police"
    }
  ]
}
{% endschema %}