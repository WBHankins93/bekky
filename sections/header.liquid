{%- comment -%}
  Header Section for Big Butt Association
  Converted from components/layout/Header.tsx
{%- endcomment -%}

<header class="sticky top-0 left-0 w-full h-16 sm:h-20 bg-black/95 border-b-2 border-bekky-purple-neon shadow-neon-purple-sm shadow-lg z-[100] backdrop-blur-md">
  <nav class="container h-full flex justify-between items-center px-4 sm:px-6">
    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="flex items-center gap-3 group">
      <img
        src="{{ 'bekky-no-background.png' | asset_url }}"
        alt="Big Butt Association Logo - Bekky the Purple Llama"
        width="50"
        height="50"
        class="h-8 sm:h-10 md:h-12 w-auto transition-all group-hover:drop-shadow-[0_0_10px_#00FF41] group-hover:drop-shadow-[0_0_20px_rgba(0,255,65,0.5)]"
        loading="eager"
      />
      <span class="font-metal text-lg sm:text-xl md:text-2xl lg:text-3xl text-bekky-purple-neon tracking-wider neon-text-purple hidden sm:block">
        Big Butt Association
      </span>
    </a>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <div class="hidden md:flex items-center gap-8">
      <a href="{{ routes.root_url }}" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Home</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="{{ routes.collections_url }}" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Shop</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="/pages/about" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">About</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="/pages/blog" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Blog</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="/pages/gallery" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Gallery</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      
      {%- comment -%} Member Button {%- endcomment -%}
      <a href="/pages/members" class="px-4 py-2 bg-transparent border-2 border-bekky-gold-neon text-bekky-gold-neon rounded-lg font-heading font-bold uppercase tracking-wide transition-all shadow-neon-gold-sm hover:bg-bekky-gold-neon hover:text-black hover:shadow-neon-gold-md">
        👑 Members
      </a>

      {%- comment -%} Cart Icon {%- endcomment -%}
      <a href="{{ routes.cart_url }}" class="relative text-2xl text-white transition-all hover:text-bekky-gold" aria-label="Shopping cart">
        🛒
        <span class="absolute -top-2 -right-2 bg-bekky-gold text-black text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center cart-count">
          {{ cart.item_count }}
        </span>
      </a>
    </div>

    {%- comment -%} Mobile Menu Button {%- endcomment -%}
    <button
      type="button"
      class="md:hidden flex flex-col gap-1.5 bg-transparent border-none cursor-pointer p-3 min-w-[44px] min-h-[44px] items-center justify-center mobile-menu-toggle"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-white transition-all mobile-menu-line-1"></span>
      <span class="block w-6 h-0.5 bg-white transition-all mobile-menu-line-2"></span>
      <span class="block w-6 h-0.5 bg-white transition-all mobile-menu-line-3"></span>
    </button>
  </nav>

  {%- comment -%} Mobile Navigation {%- endcomment -%}
  <div
    class="md:hidden fixed top-16 sm:top-20 left-0 w-full h-[calc(100vh-4rem)] sm:h-[calc(100vh-5rem)] bg-black/98 flex-col justify-start p-6 gap-4 border-r-2 border-bekky-purple-neon shadow-neon-purple-md transition-transform z-50 overflow-y-auto -webkit-overflow-scrolling-touch mobile-menu hidden -translate-x-full"
  >
    <a href="{{ routes.root_url }}" class="font-heading text-lg font-bold uppercase tracking-wide text-white w-full py-4 px-4 transition-all hover:text-bekky-purple-neon min-h-[48px] flex items-center mobile-menu-link">Home</a>
    <a href="{{ routes.collections_url }}" class="font-heading text-lg font-bold uppercase tracking-wide text-white w-full py-4 px-4 transition-all hover:text-bekky-purple-neon min-h-[48px] flex items-center mobile-menu-link">Shop</a>
    <a href="/pages/about" class="font-heading text-lg font-bold uppercase tracking-wide text-white w-full py-4 px-4 transition-all hover:text-bekky-purple-neon min-h-[48px] flex items-center mobile-menu-link">About</a>
    <a href="/pages/blog" class="font-heading text-lg font-bold uppercase tracking-wide text-white w-full py-4 px-4 transition-all hover:text-bekky-purple-neon min-h-[48px] flex items-center mobile-menu-link">Blog</a>
    <a href="/pages/gallery" class="font-heading text-lg font-bold uppercase tracking-wide text-white w-full py-4 px-4 transition-all hover:text-bekky-purple-neon min-h-[48px] flex items-center mobile-menu-link">Gallery</a>
    <a href="/pages/members" class="px-6 py-4 bg-transparent border-2 border-bekky-gold-neon text-bekky-gold-neon rounded-lg font-heading font-bold uppercase tracking-wide transition-all shadow-neon-gold-sm hover:bg-bekky-gold-neon hover:text-black hover:shadow-neon-gold-md w-full mt-2 text-center block min-h-[48px] flex items-center justify-center mobile-menu-link">
      👑 Members
    </a>
    <a href="{{ routes.cart_url }}" class="px-6 py-4 bg-transparent border-2 border-bekky-gold-neon text-bekky-gold-neon rounded-lg font-heading font-bold uppercase tracking-wide transition-all shadow-neon-gold-sm hover:bg-bekky-gold-neon hover:text-black hover:shadow-neon-gold-md w-full mt-2 text-center block min-h-[48px] flex items-center justify-center mobile-menu-link">
      🛒 Cart
    </a>
  </div>
</header>

<style>
  /* Mobile menu styles */
  .mobile-menu.active {
    display: flex !important;
    transform: translateX(0) !important;
  }

  .mobile-menu-toggle.active .mobile-menu-line-1 {
    transform: rotate(45deg) translateY(8px);
  }

  .mobile-menu-toggle.active .mobile-menu-line-2 {
    opacity: 0;
  }

  .mobile-menu-toggle.active .mobile-menu-line-3 {
    transform: rotate(-45deg) translateY(-8px);
  }
</style>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', function() {
        const isActive = menuToggle.classList.toggle('active');
        mobileMenu.classList.toggle('active');
        menuToggle.setAttribute('aria-expanded', isActive);
      });

      // Close menu when clicking a link
      menuLinks.forEach(link => {
        link.addEventListener('click', function() {
          menuToggle.classList.remove('active');
          mobileMenu.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

