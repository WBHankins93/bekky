{%- comment -%}
  Header Section for Big Butt Association
  Converted from components/layout/Header.tsx
{%- endcomment -%}

<header class="sticky top-0 left-0 w-full h-16 sm:h-20 bg-black/95 border-b-2 border-bekky-purple-neon shadow-neon-purple-sm shadow-lg z-[100] backdrop-blur-md relative">
  <nav class="container h-full flex justify-between items-center px-4 sm:px-6">
    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="flex items-center group nav-logo-container">
      <img
        src="{{ 'big-butt-logo-words.png' | asset_url }}"
        alt="Big Butt Association Logo"
        width="200"
        height="100"
        class="nav-logo-neon h-10 sm:h-14 md:h-16 w-auto transition-all"
        loading="eager"
      />
    </a>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <div class="hidden md:flex items-center gap-8">
      <a href="{{ routes.root_url }}" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Home</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="/pages/shop" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Da Goods</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="/pages/about" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">About</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      <a href="/pages/blog" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Blog</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      {%- assign gallery_page = pages['gallery'] | default: pages['gallery-1'] -%}
      <a href="{{ gallery_page.url | default: '/pages/gallery' }}" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group">
        <span class="group-hover:text-bekky-purple-neon transition-colors">Gallery</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
      </a>
      
      {%- comment -%} BBA Fam Button {%- endcomment -%}
      <a href="/pages/members" class="px-4 py-2 bg-transparent border-2 border-bekky-gold-neon text-bekky-gold-neon rounded-lg font-heading font-bold uppercase tracking-wide transition-all shadow-neon-gold-sm hover:bg-bekky-gold-neon hover:text-black hover:shadow-neon-gold-md">
        BBA Fam
      </a>

      {%- comment -%} Login Button {%- endcomment -%}
      <a href="{{ routes.account_login_url }}" class="px-3 py-2 text-sm font-heading font-bold uppercase tracking-wide text-bekky-purple-neon hover:text-bekky-gold-neon transition-colors">
        Login
      </a>

      {%- comment -%} Cart Icon {%- endcomment -%}
      <a href="{{ routes.cart_url }}" class="flex items-center gap-2 text-2xl text-white transition-all hover:text-bekky-gold" aria-label="Shopping cart">
        🛒
        <span class="bg-bekky-gold text-black text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center cart-count leading-none">
          {{ cart.item_count }}
        </span>
      </a>
    </div>

    {%- comment -%} Mobile Menu Button - Fixed with inline styles for visibility {%- endcomment -%}
    <button
      type="button"
      class="md:hidden flex flex-col gap-1.5 bg-transparent border-none cursor-pointer p-3 min-w-[44px] min-h-[44px] items-center justify-center mobile-menu-toggle relative z-[101]"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 transition-all mobile-menu-line-1" style="background-color: #9B7FFF; box-shadow: 0 0 4px rgba(155, 127, 255, 0.8), 0 0 8px rgba(155, 127, 255, 0.6);"></span>
      <span class="block w-6 h-0.5 transition-all mobile-menu-line-2" style="background-color: #9B7FFF; box-shadow: 0 0 4px rgba(155, 127, 255, 0.8), 0 0 8px rgba(155, 127, 255, 0.6);"></span>
      <span class="block w-6 h-0.5 transition-all mobile-menu-line-3" style="background-color: #9B7FFF; box-shadow: 0 0 4px rgba(155, 127, 255, 0.8), 0 0 8px rgba(155, 127, 255, 0.6);"></span>
    </button>
  </nav>

  {%- comment -%} Mobile Navigation - Dropdown Menu (matches desktop nav) {%- endcomment -%}
  <div
    class="md:hidden fixed top-16 sm:top-20 left-0 w-full flex-col justify-start p-4 gap-4 border-b-2 border-bekky-purple-neon shadow-neon-purple-md transition-all duration-300 ease-in-out overflow-hidden mobile-menu max-h-0"
    style="background-color: rgba(0, 0, 0, 1) !important; z-index: 9999 !important; position: fixed !important;"
  >
    {%- comment -%} Regular nav links - matching desktop {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group mobile-menu-link" style="color: #ffffff !important;">
      <span class="group-hover:text-bekky-purple-neon transition-colors">Home</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
    </a>
    <a href="/pages/shop" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group mobile-menu-link" style="color: #ffffff !important;">
      <span class="group-hover:text-bekky-purple-neon transition-colors">Da Goods</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
    </a>
    <a href="/pages/about" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group mobile-menu-link" style="color: #ffffff !important;">
      <span class="group-hover:text-bekky-purple-neon transition-colors">About</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
    </a>
    <a href="/pages/blog" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group mobile-menu-link" style="color: #ffffff !important;">
      <span class="group-hover:text-bekky-purple-neon transition-colors">Blog</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
    </a>
    {%- assign gallery_page = pages['gallery'] | default: pages['gallery-1'] -%}
    <a href="{{ gallery_page.url | default: '/pages/gallery' }}" class="font-heading text-base font-bold uppercase tracking-wide text-white py-2 relative transition-all group mobile-menu-link" style="color: #ffffff !important;">
      <span class="group-hover:text-bekky-purple-neon transition-colors">Gallery</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-bekky-purple-neon shadow-neon-purple-sm transition-all group-hover:w-full origin-right"></span>
    </a>
    
    {%- comment -%} BBA Fam Button - matching desktop {%- endcomment -%}
    <a href="/pages/members" class="px-4 py-2 bg-transparent border-2 border-bekky-gold-neon text-bekky-gold-neon rounded-lg font-heading font-bold uppercase tracking-wide transition-all shadow-neon-gold-sm hover:bg-bekky-gold-neon hover:text-black hover:shadow-neon-gold-md mobile-menu-link" style="border-color: #FFF67E !important; color: #FFF67E !important; box-shadow: 0 0 5px rgba(255, 246, 126, 0.5), 0 0 10px rgba(255, 246, 126, 0.5);">
      BBA Fam
    </a>

    {%- comment -%} Login Button - matching desktop {%- endcomment -%}
    <a href="{{ routes.account_login_url }}" class="px-3 py-2 text-sm font-heading font-bold uppercase tracking-wide text-bekky-purple-neon hover:text-bekky-gold-neon transition-colors mobile-menu-link" style="color: #9B7FFF !important;">
      Login
    </a>

    {%- comment -%} Cart Icon - matching desktop {%- endcomment -%}
    <a href="{{ routes.cart_url }}" class="flex items-center gap-2 text-2xl text-white transition-all hover:text-bekky-gold mobile-menu-link" aria-label="Shopping cart" style="color: #ffffff !important;">
      🛒
      <span class="bg-bekky-gold text-black text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center cart-count leading-none" style="background-color: #FFF67E !important; color: #000000 !important;">
        {{ cart.item_count }}
      </span>
    </a>
  </div>
</header>

<style>
  /* Mobile menu styles - Dropdown */
  .mobile-menu {
    display: none;
    flex-direction: column;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, max-height 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu.active {
    display: flex !important;
    max-height: 100vh !important;
    opacity: 1 !important;
    visibility: visible !important;
    overflow-y: auto;
  }
  
  .mobile-menu.active .mobile-menu-link {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .mobile-menu-toggle {
    box-shadow: 0 0 10px rgba(155, 127, 255, 0.5), 0 0 20px rgba(155, 127, 255, 0.3);
    border-radius: 0.5rem;
    transition: box-shadow 0.3s ease;
  }

  .mobile-menu-toggle:hover {
    box-shadow: 0 0 15px rgba(155, 127, 255, 0.7), 0 0 30px rgba(155, 127, 255, 0.5);
  }

  /* Hamburger line animations */
  .mobile-menu-toggle.active .mobile-menu-line-1 {
    transform: rotate(45deg) translateY(8px);
    box-shadow: 0 0 8px rgba(155, 127, 255, 0.8) !important;
  }

  .mobile-menu-toggle.active .mobile-menu-line-2 {
    opacity: 0;
  }

  .mobile-menu-toggle.active .mobile-menu-line-3 {
    transform: rotate(-45deg) translateY(-8px);
    box-shadow: 0 0 8px rgba(155, 127, 255, 0.8) !important;
  }

  /* Nav logo neon effects */
  .nav-logo-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-logo-neon {
    filter: drop-shadow(0 0 12px rgba(255, 246, 126, 0.9)) 
            drop-shadow(0 0 20px rgba(255, 246, 126, 0.8)) 
            drop-shadow(0 0 35px rgba(255, 246, 126, 0.7))
            drop-shadow(0 0 50px rgba(255, 246, 126, 0.5));
    transition: filter 0.3s ease;
  }

  .nav-logo-container:hover .nav-logo-neon {
    filter: drop-shadow(0 0 15px rgba(255, 246, 126, 1)) 
            drop-shadow(0 0 30px rgba(255, 246, 126, 0.9)) 
            drop-shadow(0 0 50px rgba(255, 246, 126, 0.8))
            drop-shadow(0 0 70px rgba(255, 246, 126, 0.6));
  }

  /* Bekky color utilities for Shopify (not compiled by Tailwind) */
  .bg-bekky-purple-neon {
    background-color: #9B7FFF;
  }

  .border-bekky-purple-neon {
    border-color: #9B7FFF;
  }

  .border-bekky-gold-neon {
    border-color: #FFF67E;
  }

  .text-bekky-purple-neon {
    color: #9B7FFF;
  }

  .text-bekky-gold-neon {
    color: #FFF67E;
  }

  .shadow-neon-purple-sm {
    box-shadow: 0 0 5px rgba(155, 127, 255, 0.5), 0 0 10px rgba(155, 127, 255, 0.5);
  }

  .shadow-neon-purple-md {
    box-shadow: 0 0 10px rgba(155, 127, 255, 0.5), 0 0 20px rgba(155, 127, 255, 0.5), 0 0 30px rgba(155, 127, 255, 0.5);
  }

  .shadow-neon-gold-sm {
    box-shadow: 0 0 5px rgba(255, 246, 126, 0.5), 0 0 10px rgba(255, 246, 126, 0.5);
  }

  .shadow-neon-gold-md {
    box-shadow: 0 0 10px rgba(255, 246, 126, 0.5), 0 0 20px rgba(255, 246, 126, 0.5), 0 0 30px rgba(255, 246, 126, 0.5);
  }

  .hover\:bg-bekky-gold-neon:hover {
    background-color: #FFF67E;
  }

  .hover\:text-bekky-purple-neon:hover {
    color: #9B7FFF;
  }

  .hover\:text-bekky-gold-neon:hover {
    color: #FFF67E;
  }

  .hover\:shadow-neon-gold-md:hover {
    box-shadow: 0 0 10px rgba(255, 246, 126, 0.5), 0 0 20px rgba(255, 246, 126, 0.5), 0 0 30px rgba(255, 246, 126, 0.5);
  }
</style>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    function closeMenu() {
      menuToggle.classList.remove('active');
      mobileMenu.classList.remove('active');
      menuToggle.setAttribute('aria-expanded', 'false');
      // Hide menu after transition completes
      setTimeout(() => {
        if (!mobileMenu.classList.contains('active')) {
          mobileMenu.style.display = 'none';
        }
      }, 300);
    }

    function openMenu() {
      // First set display to flex
      mobileMenu.style.display = 'flex';
      // Force reflow to ensure display change is applied
      void mobileMenu.offsetHeight;
      // Small delay to ensure display is set before adding active class
      setTimeout(() => {
        menuToggle.classList.add('active');
        mobileMenu.classList.add('active');
        menuToggle.setAttribute('aria-expanded', 'true');
      }, 10);
    }

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        if (menuToggle.classList.contains('active')) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      // Close menu when clicking a link
      menuLinks.forEach(link => {
        link.addEventListener('click', function() {
          closeMenu();
        });
      });

      // Close menu on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && menuToggle.classList.contains('active')) {
          closeMenu();
        }
      });

      // Close menu when clicking outside
      document.addEventListener('click', function(e) {
        if (menuToggle.classList.contains('active') && 
            !mobileMenu.contains(e.target) && 
            !menuToggle.contains(e.target)) {
          closeMenu();
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
