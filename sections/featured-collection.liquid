{%- comment -%}
  Featured Collection Section
  Converted from app/page.tsx products section
{%- endcomment -%}

<section id="shop" class="py-10 sm:py-12 md:py-16 mb-8 sm:mb-12 md:mb-16">
  <div class="container">
    <div class="section-header mb-6 sm:mb-8">
      <h2 class="section-title display-heading text-3xl sm:text-4xl md:text-5xl">{{ section.settings.title | default: 'Shop The Collection' }}</h2>
      <p class="section-subtitle text-sm sm:text-base md:text-lg px-4">
        {{ section.settings.subtitle | default: 'Bold, bootylicious, and festival-ready. Gear up for the next rave!' }}
      </p>
    </div>
  
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection == blank or collection.products_count == 0 -%}
      {%- assign collection = collections.all -%}
    {%- endif -%}
    {%- if collection and collection.products_count > 0 -%}
      {%- comment -%} Carousel Container {%- endcomment -%}
      <div class="carousel-container overflow-hidden mt-4 sm:mt-6 mb-0" style="margin-bottom: 0 !important;">
        <div class="carousel-track" data-carousel-speed="{{ section.settings.carousel_speed | default: 30 }}">
          {%- comment -%} First set of products {%- endcomment -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="carousel-item flex-shrink-0">
              <div class="product-card w-[280px] sm:w-[320px]">
                <a href="{{ product.url }}">
                  <div class="product-card-img bg-bekky-gray-dark flex items-center justify-center overflow-hidden">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="w-full h-full object-cover transition-transform duration-500"
                        loading="lazy"
                      />
                    {%- else -%}
                      <span class="text-4xl">🦙</span>
                    {%- endif -%}
                  </div>
                </a>
                <div class="p-4 relative z-10 bg-bekky-gray-dark">
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <h3 class="text-lg font-heading text-bekky-purple-neon flex-1">{{ product.title }}</h3>
                    <p class="text-bekky-gold text-xl font-bold flex-shrink-0 text-right">{{ product.price | money }}</p>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
          {%- comment -%} Duplicate set for seamless loop {%- endcomment -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="carousel-item flex-shrink-0">
              <div class="product-card w-[280px] sm:w-[320px]">
                <a href="{{ product.url }}">
                  <div class="product-card-img bg-bekky-gray-dark flex items-center justify-center overflow-hidden">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="w-full h-full object-cover transition-transform duration-500"
                        loading="lazy"
                      />
                    {%- else -%}
                      <span class="text-4xl">🦙</span>
                    {%- endif -%}
                  </div>
                </a>
                <div class="p-4 relative z-10 bg-bekky-gray-dark">
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <h3 class="text-lg font-heading text-bekky-purple-neon flex-1">{{ product.title }}</h3>
                    <p class="text-bekky-gold text-xl font-bold flex-shrink-0 text-right">{{ product.price | money }}</p>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="text-center py-12 text-bekky-gray-light">
        <p>{{ section.settings.empty_message | default: 'Products coming soon...' }}</p>
      </div>
    {%- endif -%}
    
    <div class="text-center mt-8 sm:mt-12 md:mt-16">
      <a href="{{ section.settings.view_all_link | default: '/pages/shop' }}" class="neon-button neon-button-lg">
        {{ section.settings.view_all_text | default: 'View All Products' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop The Collection"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Bold, bootylicious, and festival-ready. Gear up for the next rave!"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "Carousel Speed (seconds per cycle)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty State Message",
      "default": "Products coming soon..."
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}

