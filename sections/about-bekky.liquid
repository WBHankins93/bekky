{%- comment -%}
  About Bekky Section
  Two-column layout: Description (left) → Image (right)
  Converted from app/page.tsx about bekky section
{%- endcomment -%}

<section class="py-10 sm:py-12 md:py-16 bg-black mb-8 sm:mb-12 md:mb-16">
  <div class="container px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 items-center">
      {%- comment -%} Text Content - Left Column {%- endcomment -%}
      <div class="space-y-4 order-2 md:order-1">
        <h2 class="neon-text-purple text-3xl sm:text-4xl mb-3 font-heading">{{ section.settings.title | default: 'Meet BekkyWithABigButt' }}</h2>
        <h3 class="neon-text-gold text-xl sm:text-2xl mb-3 font-heading">{{ section.settings.subtitle | default: 'Our Fearless Leader' }}</h3>
        <div class="text-bekky-gray-light leading-relaxed">
          {{ section.settings.description }}
        </div>
      </div>
      {%- comment -%} Bekky Image - Right Column {%- endcomment -%}
      <div class="flex justify-center order-1 md:order-2">
        <img
          src="{{ section.settings.bekky_image | default: 'bekky-no-background.png' | asset_url }}"
          alt="{{ section.settings.bekky_image_alt | default: 'Bekky the Purple Alpaca with a Big Butt - Big Butt Association Mascot' }}"
          width="400"
          height="400"
          class="w-full max-w-[400px] h-auto rounded-2xl border-2 border-bekky-purple-neon shadow-neon-purple-md glow-on-hover"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Bekky",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Meet BekkyWithABigButt"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Our Fearless Leader"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>None other than BekkyWithABigButt, a multidimensional purple alpaca with curves for days and an attitude to match. She's our spirit animal—wild, free, and unapologetically herself.</p><p>If it's Bekky Approved, you know it's fire.</p>"
    },
    {
      "type": "image_picker",
      "id": "bekky_image",
      "label": "Bekky Image"
    },
    {
      "type": "text",
      "id": "bekky_image_alt",
      "label": "Bekky Image Alt Text",
      "default": "Bekky the Purple Alpaca with a Big Butt - Big Butt Association Mascot"
    }
  ],
  "presets": [
    {
      "name": "About Bekky"
    }
  ]
}
{% endschema %}