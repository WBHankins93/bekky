{%- comment -%}
  Hero Section for Big Butt Association Homepage
  Converted from app/page.tsx hero section
{%- endcomment -%}

<section class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden gradient-background">
  {%- comment -%} Scan line pattern overlay {%- endcomment -%}
  <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(155, 127, 255, 0.03) 2px, rgba(155, 127, 255, 0.03) 4px);"></div>
  
  <div class="relative z-10 text-center px-4 sm:px-6 py-8 sm:py-12 max-w-5xl mx-auto">
    {%- comment -%} Bekky Mascot - At Top {%- endcomment -%}
    <div class="flex justify-center mb-4 sm:mb-6">
      <img
        src="{{ 'bekky-no-background.png' | asset_url }}"
        alt="Bekky the Purple Alpaca Queen - Big Butt Association Mascot"
        width="300"
        height="300"
        class="max-w-[180px] sm:max-w-[250px] md:max-w-[320px] h-auto animate-float"
        loading="eager"
      />
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl mb-3 sm:mb-4 leading-tight">
      <span class="neon-text-gold block mb-1 sm:mb-2">{{ section.settings.hero_title_line1 | default: 'Festival Clothing' }}</span>
      <span class="neon-text-purple block">{{ section.settings.hero_title_line2 | default: 'For The Trippy & Bootylicious' }}</span>
    </h1>

    <p class="text-base sm:text-lg md:text-xl text-bekky-gray-light mb-8 sm:mb-10 max-w-2xl mx-auto px-4">
      {{ section.settings.hero_description | default: "We're Big Butt Association (BBA)—where bass meets booty and style meets statement. Whether you're headbanging at the rail or shuffling under neon lights, BBA is here to make sure you look as bold as you feel." }}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center px-4 mb-8 sm:mb-12">
      <a href="{{ section.settings.shop_button_link | default: '/pages/shop' }}" class="neon-button neon-button-lg w-full sm:w-auto text-center">
        {{ section.settings.shop_button_text | default: 'Shop Now' }}
      </a>
      <a href="{{ section.settings.members_button_link | default: routes.account_register_url }}" class="neon-button-gold neon-button-lg w-full sm:w-auto text-center">
        {{ section.settings.members_button_text | default: 'Join BBA Fam 👑' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "hero_title_line1",
      "label": "Hero Title Line 1",
      "default": "Festival Clothing"
    },
    {
      "type": "text",
      "id": "hero_title_line2",
      "label": "Hero Title Line 2",
      "default": "For The Trippy & Bootylicious"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "We're Big Butt Association (BBA)—where bass meets booty and style meets statement. Whether you're headbanging at the rail or shuffling under neon lights, BBA is here to make sure you look as bold as you feel."
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "members_button_text",
      "label": "BBA Fam Button Text",
      "default": "Join BBA Fam 👑"
    },
    {
      "type": "url",
      "id": "members_button_link",
      "label": "BBA Fam Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}

