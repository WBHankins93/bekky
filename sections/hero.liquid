{%- comment -%}
  Hero Section for Big Butt Association Homepage
  Converted from app/page.tsx hero section
{%- endcomment -%}

<section class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden gradient-background">
  {%- comment -%} Scan line pattern overlay {%- endcomment -%}
  <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(155, 127, 255, 0.03) 2px, rgba(155, 127, 255, 0.03) 4px);"></div>
  
  <div class="relative z-10 text-center px-4 sm:px-6 py-8 sm:py-12 max-w-5xl mx-auto">
    {%- comment -%} Big Butt Association Logo - At Top {%- endcomment -%}
    <div class="flex justify-center mb-6 sm:mb-8">
      <div class="hero-logo-container">
        <img
          src="{{ 'bba-new-logo-no-background.png.png' | asset_url }}"
          alt="Big Butt Association Logo"
          width="700"
          height="400"
          class="hero-logo-neon max-w-[280px] sm:max-w-[400px] md:max-w-[500px] lg:max-w-[600px] h-auto"
          loading="eager"
        />
      </div>
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl mb-3 sm:mb-4 leading-tight">
      <span class="neon-text-gold block mb-1 sm:mb-2">{{ section.settings.hero_title_line1 | default: 'EDM Festival Clothing' }}</span>
      <span class="neon-text-purple block">{{ section.settings.hero_title_line2 | default: 'For the Bold & Bootylicious' }}</span>
    </h1>

    <p class="text-base sm:text-lg md:text-xl text-bekky-gray-light mb-8 sm:mb-10 max-w-2xl mx-auto px-4">
      {{ section.settings.hero_description | default: "Hey, festival fam! We're Big Butt Association (BBA)—where bass meets booty and style meets statement. We're not just a brand; we're a movement, a vibe, and a celebration of every body that knows how to move to the music. Whether you're headbanging at the rail, shuffling under neon lights, or sauced on a side quest, BBA is here to make sure you look as bold as you feel." }}
    </p>

    {%- comment -%} Buttons: side-by-side {%- endcomment -%}
    <div class="flex flex-row gap-4 sm:gap-6 justify-center items-center px-4 mb-8 sm:mb-12">
      <a href="{{ section.settings.shop_button_link | default: '/pages/shop' }}" class="neon-button neon-button-lg w-full sm:w-auto sm:min-w-[200px] text-center">
        {{ section.settings.shop_button_text | default: 'Shop Now' }}
      </a>
      <a href="{{ section.settings.members_button_link | default: '/pages/members' }}" class="neon-button-gold neon-button-lg w-full sm:w-auto sm:min-w-[200px] text-center">
        {{ section.settings.members_button_text | default: 'Join BBA Fam' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "hero_title_line1",
      "label": "Hero Title Line 1",
      "default": "EDM Festival Clothing"
    },
    {
      "type": "text",
      "id": "hero_title_line2",
      "label": "Hero Title Line 2",
      "default": "For the Bold & Bootylicious"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Hey, festival fam! We're Big Butt Association (BBA)—where bass meets booty and style meets statement. We're not just a brand; we're a movement, a vibe, and a celebration of every body that knows how to move to the music. Whether you're headbanging at the rail, shuffling under neon lights, or sauced on a side quest, BBA is here to make sure you look as bold as you feel."
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "members_button_text",
      "label": "BBA Fam Button Text",
      "default": "Join BBA Fam"
    },
    {
      "type": "url",
      "id": "members_button_link",
      "label": "BBA Fam Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}