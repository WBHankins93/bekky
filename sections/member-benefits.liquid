{%- comment -%}
  Member Benefits Section
  Converted from app/page.tsx member benefits section
{%- endcomment -%}

<section class="py-12 sm:py-16 md:py-20 bg-bekky-purple-dark relative overflow-hidden">
  <div class="container px-4 sm:px-6 lg:px-8">
    <div class="section-header mb-8 sm:mb-10">
      <h2 class="section-title neon-text-gold text-2xl sm:text-3xl md:text-3xl">{{ section.settings.title | default: 'Join BBA Fam' }}</h2>
      <p class="section-subtitle text-sm sm:text-base md:text-lg px-4">
        {{ section.settings.subtitle | default: 'Earn BekkyBucks on every purchase and unlock exclusive rewards, discounts, and festival vibes!' }}
      </p>
    </div>

    {%- comment -%} Desktop: 3 columns (hidden on mobile, shown on desktop) {%- endcomment -%}
    <div class="hidden md:grid grid-cols-3 gap-6 sm:gap-8 mt-6 sm:mt-8 items-stretch max-w-6xl mx-auto">
      <div class="neon-card scan-line text-center flex flex-col p-6">
        <div class="mb-6 h-20 flex items-center justify-center">
          <span class="text-6xl animate-float leading-none">{{ section.settings.benefit1_icon | default: '💵' }}</span>
        </div>
        <h3 class="text-xl text-bekky-purple-neon mb-4 font-heading h-14 flex items-center justify-center leading-tight">
          {{ section.settings.benefit1_title | default: 'Earn BekkyBucks' }}
        </h3>
        <p class="text-bekky-gray-light flex-grow flex items-start justify-center pt-2">
          {{ section.settings.benefit1_description | default: "Get 1 BekkyBuck for every $10 spent. Stack 'em up, cash 'em in!" }}
        </p>
      </div>
      
      <div class="neon-card-gold scan-line text-center flex flex-col p-6">
        <div class="mb-6 h-20 flex items-center justify-center">
          <span class="text-6xl animate-float leading-none">{{ section.settings.benefit2_icon | default: '🎁' }}</span>
        </div>
        <h3 class="text-xl text-bekky-gold-neon mb-4 font-heading h-14 flex items-center justify-center leading-tight">
          {{ section.settings.benefit2_title | default: 'Exclusive Discounts' }}
        </h3>
        <p class="text-bekky-gray-light flex-grow flex items-start justify-center pt-2">
          {{ section.settings.benefit2_description | default: 'Member-only sales, early access to drops, and special promo codes.' }}
        </p>
      </div>
      
      <div class="neon-card scan-line text-center flex flex-col p-6">
        <div class="mb-6 h-20 flex items-center justify-center">
          <span class="text-6xl animate-float leading-none">{{ section.settings.benefit3_icon | default: '🦙' }}</span>
        </div>
        <h3 class="text-xl text-bekky-purple-neon mb-4 font-heading h-14 flex items-center justify-center leading-tight">
          {{ section.settings.benefit3_title | default: "BekkyWithABigButt's Inner Circle" }}
        </h3>
        <p class="text-bekky-gray-light flex-grow flex items-start justify-center pt-2">
          {{ section.settings.benefit3_description | default: "Join the alpaca queen's exclusive crew. Festival fam perks and more!" }}
        </p>
      </div>
    </div>
    
    {%- comment -%} Mobile: Single combined card {%- endcomment -%}
    <div class="md:hidden max-w-2xl mx-auto mt-6">
      <div class="neon-card p-6 space-y-6">
        <style>
          @media (max-width: 767px) {
            .member-benefits-mobile-item-2 h3 {
              text-align: right !important;
              display: block !important;
              width: 100% !important;
            }
          }
        </style>
        <div class="flex items-center gap-4 mb-2">
          <span class="text-5xl">{{ section.settings.benefit1_icon | default: '💵' }}</span>
          <h3 class="text-xl text-bekky-purple-neon font-heading">
            {{ section.settings.benefit1_title | default: 'Earn BekkyBucks' }}
          </h3>
        </div>
        <p class="text-bekky-gray-light text-sm">{{ section.settings.benefit1_description | default: "Get 1 BekkyBuck for every $10 spent. Stack 'em up, cash 'em in!" }}</p>
        
        <div class="border-t border-bekky-purple-neon/20 pt-6"></div>
        
        <div class="flex items-center justify-end gap-4 mb-2 member-benefits-mobile-item-2">
          <h3 class="text-xl text-bekky-gold-neon font-heading flex-1" style="text-align: right !important;">
            {{ section.settings.benefit2_title | default: 'Exclusive Discounts' }}
          </h3>
          <span class="text-5xl flex-shrink-0">{{ section.settings.benefit2_icon | default: '🎁' }}</span>
        </div>
        <p class="text-bekky-gray-light text-sm text-right">{{ section.settings.benefit2_description | default: 'Member-only sales, early access to drops, and special promo codes.' }}</p>
        
        <div class="border-t border-bekky-purple-neon/20 pt-6"></div>
        
        <div class="flex items-center gap-4 mb-2">
          <span class="text-5xl">{{ section.settings.benefit3_icon | default: '🦙' }}</span>
          <h3 class="text-xl text-bekky-purple-neon font-heading">
            {{ section.settings.benefit3_title | default: "BekkyWithABigButt's Inner Circle" }}
          </h3>
        </div>
        <p class="text-bekky-gray-light text-sm">{{ section.settings.benefit3_description | default: "Join the alpaca queen's exclusive crew. Festival fam perks and more!" }}</p>
      </div>
    </div>
    
    {%- comment -%} CTA Button - centered with proper spacing and reasonable width {%- endcomment -%}
    <div class="text-center mt-16 sm:mt-20">
      <a href="{{ section.settings.cta_link | default: routes.account_register_url }}" class="neon-button-gold neon-button-lg inline-block px-12 sm:px-16">
        {{ section.settings.cta_text | default: 'Join BBA Fam' }}
      </a>
    </div>
  </div>
</section>

