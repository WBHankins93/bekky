{%- comment -%}
  Newsletter Signup Section
  Converted from app/page.tsx newsletter section
{%- endcomment -%}

<section class="newsletter-section py-16 sm:py-20 md:py-24 bg-gradient-to-br from-bekky-purple to-bekky-purple-dark text-center">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto">
      {%- comment -%} Form in its own box for differentiation {%- endcomment -%}
      <div class="newsletter-form-wrapper flex flex-col items-center max-w-md mx-auto mb-8 sm:mb-10">
        <div class="neon-card p-6 w-full text-center">
          <h2 class="neon-text-gold text-2xl sm:text-3xl md:text-3xl mb-3 font-heading">{{ section.settings.title | default: 'Stay In The Loop' }}</h2>
          <p class="text-base sm:text-lg text-bekky-gray-light mb-5 sm:mb-6">
            {{ section.settings.subtitle | default: 'Get exclusive drops, festival tips, and BekkyBucks bonus offers straight to your inbox!' }}
          </p>
          {%- form 'customer', class: 'flex flex-col items-center gap-4 w-full' -%}
            <input 
              type="email" 
              name="contact[email]"
              class="form-input text-center w-full" 
              placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" 
              required
            />
            <button type="submit" class="neon-button-gold neon-button-lg w-full">
              {{ section.settings.button_text | default: 'Subscribe 🎉' }}
            </button>
          {%- endform -%}
        </div>
      </div>
      
      <div class="space-y-4 mt-12 sm:mt-16">
        <h2 class="neon-text-gold text-2xl sm:text-3xl md:text-3xl mb-3 font-heading">Follow Us</h2>
        <p class="text-bekky-gray-light text-sm sm:text-base mb-5 sm:mb-6">
          👉 Follow BekkyWithABigButt & the BBA fam. Stay dripped, stay vibin', and most importantly—<strong class="neon-text-gold">Stay Trippy, Drink Water</strong>.
        </p>
        <div class="flex flex-col items-center gap-3">
          <div class="flex flex-col sm:flex-row gap-3 items-center">
            <a href="https://www.instagram.com/bekkywithabigbutt/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 group">
              <div class="flex items-center justify-center w-10 h-10 bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-full transition-all hover:bg-bekky-purple-neon hover:shadow-neon-purple-md hover:-translate-y-0.5">
