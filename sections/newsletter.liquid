                </svg>
              </div>
              <span class="text-bekky-gray-light text-sm group-hover:text-bekky-purple-neon transition-colors">@dr.kushking</span>
            </a>
          </div>
        </div>
        <div class="flex flex-wrap justify-center gap-2 sm:gap-3 pt-2">
          <a href="https://www.instagram.com/explore/tags/bigbootyenergy/" target="_blank" rel="noopener noreferrer" class="text-bekky-purple-neon text-xs sm:text-sm hover:text-bekky-gold-neon transition-colors">#BigBootyEnergy</a>
          <a href="https://www.instagram.com/explore/tags/bekkywithabigbutt/" target="_blank" rel="noopener noreferrer" class="text-bekky-purple-neon text-xs sm:text-sm hover:text-bekky-gold-neon transition-colors">#BekkyWithABigButt</a>
          <a href="https://www.instagram.com/explore/tags/bbafam/" target="_blank" rel="noopener noreferrer" class="text-bekky-purple-neon text-xs sm:text-sm hover:text-bekky-gold-neon transition-colors">#BBAFam</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-gradient-to-br {
    background: linear-gradient(to bottom right, var(--bekky-purple), var(--bekky-purple-dark));
  }
  
  /* Ensure proper centering of newsletter content */
  .newsletter-section .container > div {
    width: 100% !important;
    max-width: 42rem !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
  }
  
  /* Ensure form container is properly centered */
  .newsletter-section .newsletter-form-wrapper {
    width: 100% !important;
    max-width: 28rem !important;
    margin-left: auto !important;
    margin-right: auto !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Stay In The Loop"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Get exclusive drops, festival tips, and BekkyBucks bonus offers straight to your inbox!"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe 🎉"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}