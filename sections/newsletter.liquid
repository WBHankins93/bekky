{%- comment -%}
  Newsletter Signup Section
  Converted from app/page.tsx newsletter section
{%- endcomment -%}

<section class="py-10 sm:py-12 bg-gradient-to-br from-bekky-purple to-bekky-purple-dark">
  <div class="container px-4">
    <div class="text-center max-w-2xl mx-auto w-full">
      <h2 class="neon-text-gold text-2xl sm:text-3xl md:text-3xl mb-3 font-heading">{{ section.settings.title | default: 'Stay In The Loop' }}</h2>
      <p class="text-base sm:text-lg text-bekky-gray-light mb-5 sm:mb-6">
        {{ section.settings.subtitle | default: 'Get exclusive drops, festival tips, and BekkyBucks bonus offers straight to your inbox!' }}
      </p>
      
      {%- comment -%} Form centered with flex column and items-center {%- endcomment -%}
      {%- form 'customer', class: 'flex flex-col items-center gap-4 w-full' -%}
        <input 
          type="email" 
          name="contact[email]"
          class="form-input text-center w-full max-w-md" 
          placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" 
          required
        />
        <button type="submit" class="neon-button-gold neon-button-lg w-full max-w-md">
          {{ section.settings.button_text | default: 'Subscribe 🎉' }}
        </button>
      {%- endform -%}
      
      <div class="mt-6 space-y-2">
        <p class="text-bekky-gray-light text-sm">
          👉 Follow BekkyWithABigButt & the BBA fam. Stay dripped, stay vibin', and most importantly—<strong class="neon-text-gold">Stay Trippy, Drink Water</strong>.
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="text-bekky-purple-neon text-xs">#BigBootyEnergy</span>
          <span class="text-bekky-purple-neon text-xs">#BekkyWithABigButt</span>
          <span class="text-bekky-purple-neon text-xs">#BBAFam</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-gradient-to-br {
    background: linear-gradient(to bottom right, var(--bekky-purple), var(--bekky-purple-dark));
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Stay In The Loop"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Get exclusive drops, festival tips, and BekkyBucks bonus offers straight to your inbox!"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe 🎉"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}