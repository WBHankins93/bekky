{%- comment -%}
  Footer Section for Big Butt Association
  Converted from components/layout/Footer.tsx
{%- endcomment -%}

<footer class="bg-bekky-gray-dark border-t-2 border-bekky-purple-neon shadow-[0_-4px_20px_rgba(155,127,255,0.2)] py-8 sm:py-12 mt-16 sm:mt-24 md:mt-32">
  <div class="container px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 mb-6 sm:mb-8">
      {%- comment -%} Brand {%- endcomment -%}
      <div class="space-y-4">
        <div class="flex items-center gap-3 mb-4">
          <img
            src="{{ 'bekky-no-background.png' | asset_url }}"
            alt="Big Butt Association Logo - Bekky the Purple Alpaca"
            width="40"
            height="40"
            class="h-10 w-auto"
            loading="lazy"
          />
          <span class="font-metal text-lg sm:text-xl text-bekky-purple-neon tracking-wider neon-text-purple">
            Big Butt Association
          </span>
        </div>
        <div class="mt-4 space-y-3">
          <p class="text-bekky-gray-light text-sm">
            Stay dripped, stay vibin', and most importantly—<strong class="neon-text-gold">Stay Trippy, Drink Water</strong>.
          </p>
          <div class="flex flex-wrap gap-2">
            <a href="https://www.instagram.com/explore/tags/bigbootyenergy/" target="_blank" rel="noopener noreferrer" class="text-bekky-purple-neon text-xs hover:text-bekky-gold-neon transition-colors">#BigBootyEnergy</a>
            <a href="https://www.instagram.com/explore/tags/bekkywithabigbutt/" target="_blank" rel="noopener noreferrer" class="text-bekky-purple-neon text-xs hover:text-bekky-gold-neon transition-colors">#BekkyWithABigButt</a>
            <a href="https://www.instagram.com/explore/tags/bbafam/" target="_blank" rel="noopener noreferrer" class="text-bekky-purple-neon text-xs hover:text-bekky-gold-neon transition-colors">#BBAFam</a>
          </div>
        </div>
        
        <div class="space-y-3 mt-4">
          <div class="flex flex-col gap-2">
            <h4 class="text-bekky-gold text-sm font-heading">Follow Us</h4>
            <div class="flex flex-col gap-3">
              <a href="https://www.instagram.com/big_butt_association/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 group">
                <div class="flex items-center justify-center w-10 h-10 bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-full transition-all hover:bg-bekky-purple-neon hover:shadow-neon-purple-md hover:-translate-y-0.5">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-bekky-purple-neon group-hover:text-black transition-colors">
