{%- comment -%}
  Footer Section for Big Butt Association
  Converted from components/layout/Footer.tsx
{%- endcomment -%}

<footer class="bg-bekky-gray-dark border-t-2 border-bekky-purple-neon shadow-[0_-4px_20px_rgba(155,127,255,0.2)] py-8 sm:py-12 mt-16 sm:mt-24 md:mt-32">
  <div class="container px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 mb-6 sm:mb-8">
      {%- comment -%} Brand {%- endcomment -%}
      <div class="space-y-4">
        <div class="flex items-center gap-3 mb-4">
          <img
            src="{{ 'bekky-no-background.png' | asset_url }}"
            alt="Big Butt Association Logo - Bekky the Purple Alpaca"
            width="40"
            height="40"
            class="h-10 w-auto"
            loading="lazy"
          />
          <span class="font-metal text-lg sm:text-xl text-bekky-purple-neon tracking-wider neon-text-purple">
            Big Butt Association
          </span>
        </div>
        <p class="text-bekky-gray-light text-sm">
          Festival clothing for the trippy & bootylicious. Join the movement!
        </p>
        
        <div class="mt-6 space-y-3">
          <p class="text-bekky-gray-light text-sm">
            👉 Follow BekkyWithABigButt & the BBA fam. Stay dripped, stay vibin', and most importantly—<strong class="neon-text-gold">Stay Trippy, Drink Water</strong>.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="text-bekky-purple-neon text-xs">#BigBootyEnergy</span>
            <span class="text-bekky-purple-neon text-xs">#BekkyWithABigButt</span>
            <span class="text-bekky-purple-neon text-xs">#BBAFam</span>
          </div>
        </div>
        
        <div class="flex gap-4 mt-4">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-full text-bekky-purple-neon text-xl transition-all hover:bg-bekky-purple-neon hover:text-black hover:shadow-neon-purple-md hover:-translate-y-0.5" aria-label="Instagram">
              📷
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-full text-bekky-purple-neon text-xl transition-all hover:bg-bekky-purple-neon hover:text-black hover:shadow-neon-purple-md hover:-translate-y-0.5" aria-label="TikTok">
              🎵
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-full text-bekky-purple-neon text-xl transition-all hover:bg-bekky-purple-neon hover:text-black hover:shadow-neon-purple-md hover:-translate-y-0.5" aria-label="Twitter">
              🐦
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 bg-bekky-purple-neon/10 border-2 border-bekky-purple-neon rounded-full text-bekky-purple-neon text-xl transition-all hover:bg-bekky-purple-neon hover:text-black hover:shadow-neon-purple-md hover:-translate-y-0.5" aria-label="Facebook">
              📘
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Shop {%- endcomment -%}
      <div>
        <h3 class="text-bekky-gold text-xl mb-6 font-heading">Shop</h3>
        <div class="flex flex-col gap-2">
          <a href="{{ routes.collections_url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
            All Products
          </a>
          {%- for collection in collections -%}
            {%- if collection.handle != 'all' -%}
              <a href="{{ collection.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
                {{ collection.title }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} About BBA {%- endcomment -%}
      <div>
        <h3 class="text-bekky-gold text-xl mb-6 font-heading">About BBA</h3>
        <div class="flex flex-col gap-2">
          {%- assign about_page = pages['about'] -%}
          {%- if about_page -%}
            <a href="{{ about_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Our Story
            </a>
            <a href="{{ about_page.url }}#bekky" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Meet BekkyWithABigButt
            </a>
          {%- endif -%}
          <a href="{{ routes.account_url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
            BBA Fam & BekkyBucks
          </a>
          {%- assign blog = blogs['festival-blog'] -%}
          {%- if blog -%}
            <a href="{{ blog.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Festival Blog
            </a>
          {%- endif -%}
          {%- assign contact_page = pages['contact'] -%}
          {%- if contact_page -%}
            <a href="{{ contact_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Contact Us
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Support {%- endcomment -%}
      <div>
        <h3 class="text-bekky-gold text-xl mb-6 font-heading">Support</h3>
        <div class="flex flex-col gap-2">
          {%- assign shipping_page = pages['shipping-returns'] -%}
          {%- if shipping_page -%}
            <a href="{{ shipping_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Shipping & Returns
            </a>
          {%- endif -%}
          {%- assign size_guide_page = pages['size-guide'] -%}
          {%- if size_guide_page -%}
            <a href="{{ size_guide_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Size Guide
            </a>
          {%- endif -%}
          {%- assign faq_page = pages['faq'] -%}
          {%- if faq_page -%}
            <a href="{{ faq_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              FAQ
            </a>
          {%- endif -%}
          {%- assign privacy_page = pages['privacy-policy'] -%}
          {%- if privacy_page -%}
            <a href="{{ privacy_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Privacy Policy
            </a>
          {%- endif -%}
          {%- assign terms_page = pages['terms-of-service'] -%}
          {%- if terms_page -%}
            <a href="{{ terms_page.url }}" class="text-bekky-gray-light transition-all hover:text-bekky-purple-neon hover:shadow-neon-purple-sm hover:pl-2">
              Terms of Service
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} Footer Bottom {%- endcomment -%}
    <div class="pt-8 border-t border-bekky-purple-neon/20 text-center text-bekky-gray-light">
      <div class="neon-divider-gold mb-6"></div>
      <p class="text-sm">
        &copy; {{ 'now' | date: '%Y' }} Big Butt Association. All rights reserved. Built by
        <a
          href="https://www.sproutflow-studio.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="neon-text-purple hover:text-bekky-gold-neon transition-colors"
        >
          Sproutflow Studio
        </a>
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "social_instagram_link",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "social_tiktok_link",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "social_twitter_link",
      "label": "Twitter URL"
    },
    {
      "type": "text",
      "id": "social_facebook_link",
      "label": "Facebook URL"
    }
  ]
}
{% endschema %}

